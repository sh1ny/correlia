# Copy to .env for local Compose use, then replace every replace-with-* value.
# These placeholders are deliberately non-operational and are not secrets.
POSTGRES_DB=correlia
POSTGRES_USER=correlia
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgresql+asyncpg://correlia:replace-with-postgres-password@postgres:5432/correlia

# Intentionally local: selecting production alone must reject the public metrics flag.
# For production set CORRELIA_ENVIRONMENT=production, keep CORRELIA_API_AUTH_ENABLED=true,
# and explicitly set both CORRELIA_EXPOSE_READYZ=false and CORRELIA_EXPOSE_METRICS=false.
# Application auth remains mandatory behind a proxy; see CONFIGURATION.md for TLS/network duties.
CORRELIA_ENVIRONMENT=local
CORRELIA_LOG_LEVEL=INFO
CORRELIA_RULES_PATH=/app/config/rules.yaml
CORRELIA_TOPOLOGY_PATH=/app/config/topology.yaml
CORRELIA_PLUGINS_PATH=/app/config/plugins.yaml

CORRELIA_API_AUTH_ENABLED=true
# Operator token, ingress token, and audit HMAC key must be distinct, non-empty secrets.
# Supply real deployment values privately; never commit them or log rendered Compose config.
CORRELIA_OPERATOR_API_TOKEN=replace-with-operator-token
CORRELIA_INGRESS_API_TOKEN=replace-with-ingress-token
CORRELIA_EXPOSE_READYZ=false
# Local public metrics is intentional; change to false for production.
CORRELIA_EXPOSE_METRICS=true
# Optional: JSON emitted by scripts/migrate_vigilo_config.py --report-path.
# Leave unset to disable bounded migration-report gauges on /v1/metrics.
# CORRELIA_MIGRATION_REPORT_PATH=/app/config/migration-report.json
CORRELIA_AUDIT_RAW_PAYLOAD_HMAC_KEY=replace-with-audit-hmac-key
